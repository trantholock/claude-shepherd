SETTINGS = os.path.expanduser("~/.claude/settings.json")
HOOK_EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "Stop", "SessionEnd"]
_OURS = re.compile(r"""ccmon['"]? hook""")


def settings_hooks(action, cmd=""):
    """Thêm/gỡ hook + statusLine của ccmon trong ~/.claude/settings.json (idempotent, có backup).
    cmd: lệnh hook, kết thúc bằng " hook"; statusLine dùng cùng lệnh với " statusline"."""
    s = read_json(SETTINGS, None)
    if s is None and os.path.exists(SETTINGS):
        raise SystemExit("%s is not valid JSON; fix it first" % SETTINGS)
    s = s or {}
    if os.path.exists(SETTINGS):
        shutil.copy(SETTINGS, SETTINGS + ".bak-ccmon-" + time.strftime("%Y%m%d%H%M%S"))
    is_ours = lambda e: any(_OURS.search(h.get("command", "")) for h in e.get("hooks", []))
    hooks = s.setdefault("hooks", {})
    for ev in HOOK_EVENTS:
        lst = [e for e in hooks.get(ev, []) if not is_ours(e)]
        if action == "install":
            e = {"hooks": [{"type": "command", "command": cmd, "timeout": 5}]}
            if ev in ("PreToolUse", "PostToolUse"):
                e["matcher"] = "*"
            lst.append(e)
        if lst:
            hooks[ev] = lst
        else:
            hooks.pop(ev, None)
    if not hooks:
        s.pop("hooks")
    # statusLine: chỉ chiếm chỗ khi chưa có statusLine riêng của người dùng
    sl = s.get("statusLine") or {}
    ours = "ccmon" in sl.get("command", "")
    if action == "install" and (not sl or ours):
        s["statusLine"] = {"type": "command", "command": cmd[:-len(" hook")] + " statusline"}
    elif action == "install":
        print(T("keeping your statusLine (%s): quota will not be updated",
                "giữ statusLine hiện có (%s) — quota sẽ không được cập nhật") % sl.get("command"))
    elif ours:
        s.pop("statusLine")
    write_json(SETTINGS, s)
    print("hooks %s: %s" % (action, ", ".join(HOOK_EVENTS)))


def _py(gui=False):
    py = sys.executable or "python3"
    if IS_WIN and gui:  # pythonw: không có cửa sổ console cho tiến trình chạy nền
        w = os.path.join(os.path.dirname(py), "pythonw.exe")
        return w if os.path.exists(w) else py
    return py


def _self():
    # không realpath: giữ đường dẫn symlink (~/.local/bin/ccmon, /usr/bin/ccmon) cho ổn định khi nâng cấp
    return os.path.abspath(sys.argv[0] if os.path.basename(sys.argv[0]).startswith("ccmon") else __file__)


def hook_command():
    if IS_WIN:  # dấu " + / chạy được cả trong Git Bash lẫn cmd.exe
        q = lambda p: '"%s"' % p.replace("\\", "/")
    else:
        q = shlex.quote
    return "%s %s hook" % (q(_py()), q(_self()))


SYSTEMD_UNIT = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                            "systemd", "user", "claude-shepherd.service")
WIN_RUN_KEY = r"Software\Microsoft\Windows\CurrentVersion\Run"
WIN_RUN_NAME = "ClaudeShepherd"
PIDFILE = os.path.join(BASE, "serve.pid")


def _systemctl(*a):
    try:
        return subprocess.run(["systemctl", "--user"] + list(a), capture_output=True, text=True).returncode == 0
    except OSError:
        return False


def _stop_pidfile():
    try:
        pid = int(open(PIDFILE).read().strip())
    except (OSError, ValueError):
        return
    if pid_alive(pid) and is_python_proc(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    try:
        os.remove(PIDFILE)
    except OSError:
        pass


def is_python_proc(pid):
    n = (ps_table().get(pid) or "").lower()
    return "python" in n or "ccmon" in n


def service(action):
    """Linux: systemd --user unit. Windows: khoá Run trong HKCU (không cần quyền admin)."""
    os.makedirs(BASE, exist_ok=True)
    if IS_WIN:
        import winreg
        with winreg.CreateKey(winreg.HKEY_CURRENT_USER, WIN_RUN_KEY) as k:
            if action == "install":
                winreg.SetValueEx(k, WIN_RUN_NAME, 0, winreg.REG_SZ,
                                  '"%s" "%s" serve' % (_py(gui=True), _self()))
            else:
                try:
                    winreg.DeleteValue(k, WIN_RUN_NAME)
                except OSError:
                    pass
