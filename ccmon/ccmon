#!/usr/bin/env python3
"""ccmon — track every Claude Code session (terminal + VS Code).

  ccmon hook            # called by Claude Code hooks (reads JSON from stdin)
  ccmon [ls] [-a] [text] # status table (-a: include closed sessions; text: search)
  ccmon watch           # table that refreshes every 2s
  ccmon serve [port]    # web dashboard http://127.0.0.1:7788
  ccmon focus <id>      # jump to the session's terminal tab (iTerm) / VS Code window
  ccmon term <id>       # open the session in a new terminal tab (claude --resume; --fork-session if still live)
  ccmon ack <id|all>    # mark as seen
  ccmon clean           # delete closed sessions
  ccmon name <id> [name] # give a session a memorable name (empty = clear)
  ccmon usage           # Claude plan quota, 5h / 7d
  ccmon lang [en|vi|auto]  # UI language (default: follows the OS)
  ccmon statusline      # called by Claude Code statusLine: stores quota + session name
  ccmon restore [all|<id>|dismiss [id]]  # reopen sessions that closed unexpectedly (crash, reboot)
  ccmon restore mode [ask|auto|off]      # ask (default): notify + offer; auto: reopen on its own
  ccmon setup [--no-service]     # Linux/Windows: add hooks + start the dashboard at login
  ccmon teardown [--no-service]  # Linux/Windows: remove hooks + the login service (keeps data)
  ccmon version
"""
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import unicodedata
from urllib.parse import unquote

VERSION = "1.2.0"
IS_WIN = sys.platform == "win32"
IS_MAC = sys.platform == "darwin"
IS_LINUX = sys.platform.startswith("linux")
# Windows: không bật cửa sổ console cho tiến trình con (notify, PowerShell)
NO_WINDOW = 0x08000000 if IS_WIN else 0

BASE = os.path.expanduser("~/.claude/ccmon")
STATE = os.path.join(BASE, "sessions")
SL_DIR = os.path.join(BASE, "statusline")   # dữ liệu statusLine theo phiên (tách file để không giẫm lên hook)
NAMES = os.path.join(BASE, "names.json")    # tên do người dùng đặt
USAGE = os.path.join(BASE, "usage.json")    # quota gần nhất
KEEP_CLOSED_SEC = 24 * 3600
KEEP_LOST_SEC = 3 * 24 * 3600   # phiên bị tắt đột ngột được đề nghị khôi phục trong 3 ngày
NOTIFY = os.environ.get("CCMON_NOTIFY", "1") != "0"

ORDER = ["lost", "waiting", "done", "interrupted", "running", "idle", "closed"]


# ---------- lưu trữ ----------

def _path(sid):
    return os.path.join(STATE, sid + ".json")


def load(sid):
    try:
        with open(_path(sid), encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def save(s):
    os.makedirs(STATE, exist_ok=True)
    tmp = _path(s["session_id"]) + ".%d.tmp" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(s, f, ensure_ascii=False)
    _replace(tmp, _path(s["session_id"]))


def _replace(tmp, dst):
    # Windows: os.replace lỗi PermissionError khi tiến trình khác (dashboard) đang mở dst -> thử lại
    for i in range(20):
        try:
            return os.replace(tmp, dst)
        except PermissionError:
            if not IS_WIN or i == 19:
                raise
            time.sleep(0.025)


def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def read_stdin_json():
    # Claude Code gửi UTF-8; trên Windows sys.stdin mặc định theo code page (cp1252...) -> đọc bytes
    return json.loads(sys.stdin.buffer.read().decode("utf-8", "replace") or "{}")


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    _replace(tmp, path)


# ---------- ngôn ngữ ----------

CONFIG = os.path.join(BASE, "config.json")  # {"lang": "en" | "vi"}
_VI = None


def is_vi():
    """CCMON_LANG > config.json > ngôn ngữ của hệ điều hành; mặc định tiếng Anh."""
    global _VI
    if _VI is None:
        lang = os.environ.get("CCMON_LANG") or read_json(CONFIG, {}).get("lang") or os_lang()
        _VI = lang.lower().startswith("vi")
    return _VI


def os_lang():
    try:
        if IS_MAC:
            out = subprocess.check_output(["defaults", "read", "-g", "AppleLanguages"],
                                          text=True, stderr=subprocess.DEVNULL)
            return out.strip("()\n ").split(",")[0].strip().strip('"')
        if IS_WIN:
            import ctypes
            # primary language id của UI; 0x2a = LANG_VIETNAMESE
            return "vi" if ctypes.windll.kernel32.GetUserDefaultUILanguage() & 0x3FF == 0x2A else "en"
    except Exception:
        return ""
    for k in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(k):
            return os.environ[k]
    return ""


def T(en, vi):
    return vi if is_vi() else en


def label(st):
    return {
        "waiting": T("WAITING", "CHỜ BẠN"),
        "done": T("DONE", "XONG"),
        "running": T("RUNNING", "ĐANG CHẠY"),
        "interrupted": T("INTERRUPTED", "BỊ NGẮT"),
        "idle": T("OPEN, IDLE", "MỞ, CHƯA LÀM"),
        "closed": T("CLOSED", "ĐÃ ĐÓNG"),
        "lost": T("CLOSED UNEXPECTEDLY", "BỊ TẮT ĐỘT NGỘT"),
    }[st]


def set_name(sid, name):
    names = read_json(NAMES, {})
    name = (name or "").strip()[:80]
    if name:
        names[sid] = name
    else:
        names.pop(sid, None)
    write_json(NAMES, names)


def title_of(s, names=None, sl=None):
    """Tên hiển thị: tên tự đặt > tên Claude tự đặt (session_name) > tên thư mục."""
    if names is None:
        names = read_json(NAMES, {})
    if sl is None:
        sl = read_json(os.path.join(SL_DIR, s["session_id"] + ".json"), {})
    return (names.get(s["session_id"]) or sl.get("session_name")
            or os.path.basename((s.get("cwd") or "").rstrip("/\\")) or "?")


def all_sessions():
    out = []
    if not os.path.isdir(STATE):
        return out
    for fn in os.listdir(STATE):
        if fn.endswith(".json"):
            s = load(fn[:-5])
            if s:
                out.append(s)
    return out


def find(prefix):
    m = [s for s in all_sessions() if s["session_id"].startswith(prefix)]
    return m[0] if len(m) == 1 else None


# ---------- hook ----------

# ---------- tiến trình (macOS: ps, Linux: /proc, Windows: Toolhelp32 qua ctypes) ----------

def _linux_proc(pid):
    """(ppid, tên) của pid. Tên = argv[0] + đường dẫn exe, vì bản claude native trên Linux
    có comm là số version (vd "2.1.3") chứ không phải "claude"."""
    with open("/proc/%d/stat" % pid, "rb") as f:
        st = f.read().decode("utf-8", "replace")
    ppid = int(st[st.rfind(")") + 2:].split()[1])
    name = st[st.find("(") + 1:st.rfind(")")]
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            argv0 = f.read().split(b"\0", 1)[0].decode("utf-8", "replace")
        name = "%s %s" % (argv0 or name, os.readlink("/proc/%d/exe" % pid))
    except OSError:
        pass
    return ppid, name


def _win_procs():
    """{pid: (ppid, exe)} cho mọi tiến trình — stdlib, không gọi PowerShell (hook phải nhanh)."""
    import ctypes
    from ctypes import wintypes

    class PE(ctypes.Structure):
        _fields_ = [("dwSize", wintypes.DWORD), ("cntUsage", wintypes.DWORD),
                    ("th32ProcessID", wintypes.DWORD), ("th32DefaultHeapID", ctypes.c_size_t),
                    ("th32ModuleID", wintypes.DWORD), ("cntThreads", wintypes.DWORD),
                    ("th32ParentProcessID", wintypes.DWORD), ("pcPriClassBase", ctypes.c_long),
                    ("dwFlags", wintypes.DWORD), ("szExeFile", ctypes.c_wchar * 260)]

    k = ctypes.WinDLL("kernel32", use_last_error=True)
    k.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
    k.CreateToolhelp32Snapshot.argtypes = [wintypes.DWORD, wintypes.DWORD]
    k.Process32FirstW.argtypes = k.Process32NextW.argtypes = [wintypes.HANDLE, ctypes.POINTER(PE)]
    k.CloseHandle.argtypes = [wintypes.HANDLE]
    snap = k.CreateToolhelp32Snapshot(0x2, 0)  # TH32CS_SNAPPROCESS
    if not snap or snap == ctypes.c_void_p(-1).value:
        return {}
    out = {}
    e = PE()
    e.dwSize = ctypes.sizeof(PE)
    try:
        ok = k.Process32FirstW(snap, ctypes.byref(e))
        while ok:
            out[e.th32ProcessID] = (e.th32ParentProcessID, e.szExeFile)
            ok = k.Process32NextW(snap, ctypes.byref(e))
    finally:
        k.CloseHandle(snap)
    return out


def proc_parent(pid, _win=None):
    """(ppid, tên tiến trình) hoặc None."""
    try:
        if IS_LINUX:
            return _linux_proc(pid)
        if IS_WIN:
            return (_win if _win is not None else _win_procs()).get(pid)
        out = subprocess.check_output(["ps", "-o", "ppid=,comm=", "-p", str(pid)], text=True).strip()
        ppid, comm = out.split(None, 1)
        return int(ppid), comm
    except Exception:
        return None


def is_claude_proc(name, vscode=False):
    n = (name or "").lower()
    base = re.split(r"[/\\]", n.split(" ", 1)[0])[-1]
    if "claude" in n or base in ("node", "node.exe") or n.endswith("/node"):
        return True
    # extension VS Code chạy claude bên trong tiến trình helper của Code
    return vscode and ("code helper" in n or base == "code.exe")


def claude_pid():
    p = os.environ.get("CLAUDE_PID")
    if p and p.isdigit():
        return int(p)
    pid = os.getppid()
    win = _win_procs() if IS_WIN else None
    for _ in range(5):
        info = proc_parent(pid, win)
        if not info:
            return None
        ppid, comm = info
        if is_claude_proc(comm):
            return pid
        pid = ppid
    return None


def proc_args(pid):
    try:
        if IS_LINUX:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                return f.read().replace(b"\0", b" ").decode("utf-8", "replace")
        if IS_WIN:
            # chỉ gọi cho phiên headless (hiếm) nên chấp nhận chi phí khởi động PowerShell
            return subprocess.check_output(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command",
                 "(Get-CimInstance Win32_Process -Filter 'ProcessId=%d').CommandLine" % int(pid)],
                text=True, stderr=subprocess.DEVNULL, timeout=4, creationflags=NO_WINDOW)
        return subprocess.check_output(["ps", "-o", "args=", "-p", str(pid)], text=True)
    except Exception:
        return ""


def pid_alive(pid):
    if IS_WIN:  # os.kill(pid, 0) trên Windows = gửi CTRL_C_EVENT, không phải kiểm tra
        return pid in _win_procs()
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def remote_url_of_pid(pid):
    """Phiên do `claude remote-control` sinh ra (mở từ app mobile/claude.ai) chạy với
    --sdk-url .../code/sessions/cse_XXX -> trang web https://claude.ai/code/session_XXX."""
    if not pid:
        return ""
    args = proc_args(pid)
    m = re.search(r"/code/sessions/cse_([A-Za-z0-9]+)", args)
    return "https://claude.ai/code/session_" + m.group(1) if m else ""


def host_info():
    ep = os.environ.get("CLAUDE_CODE_ENTRYPOINT", "")
    tp = os.environ.get("TERM_PROGRAM", "")
    if "vscode" in ep:
        app = "VSCode"
    elif tp == "vscode":
        app = "VSCode-term"
    elif tp == "iTerm.app":
        app = "iTerm"
    elif ep in ("sdk-cli", "sdk-ts", "sdk-py") or ep.startswith("sdk"):
        app = "headless"
    else:
        app = tp or ep or "?"
    # VSCode mở từ iTerm sẽ kế thừa ITERM_SESSION_ID -> bỏ qua để không focus nhầm
    iterm = "" if app.startswith("VSCode") else os.environ.get("ITERM_SESSION_ID", "")
    return {"app": app, "entry": ep, "iterm": iterm.split(":", 1)[-1] if iterm else ""}


def last_reply(transcript):
    """Câu trả lời text cuối của assistant trong transcript."""
    try:
        with open(transcript, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 400_000))
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except Exception:
        return ""
    for ln in reversed(lines):
        try:
            e = json.loads(ln)
        except Exception:
            continue
        if e.get("type") != "assistant":
            continue
        for c in reversed((e.get("message") or {}).get("content") or []):
            if isinstance(c, dict) and c.get("type") == "text" and c.get("text", "").strip():
                return c["text"].strip()
    return ""


def was_interrupted(transcript):
    try:
        with open(transcript, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 20_000))
            tail = f.read().decode("utf-8", "ignore").splitlines()[-3:]
    except Exception:
        return False
    return any("Request interrupted by user" in ln for ln in tail)


def notify(title, msg):
    if not NOTIFY:
        return
    title, msg = title[:120], msg[:220]
    env = None
    try:
        if IS_MAC:
            q = lambda x: x.replace("\\", "\\\\").replace('"', '\\"')
            script = 'display notification "%s" with title "%s" sound name "Glass"' % (q(msg), q(title))
            cmd = ["osascript", "-e", script]
        elif IS_WIN:
            cmd = ["powershell", "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden",
                   "-Command", WIN_TOAST]
            env = dict(os.environ, CCMON_TOAST_TITLE=title, CCMON_TOAST_MSG=msg)
        elif shutil.which("notify-send"):
            cmd = ["notify-send", "-a", "Claude Shepherd", title, msg]
        else:
            return
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, env=env, creationflags=NO_WINDOW)
    except Exception:
        pass


# Toast Windows 10/11 qua WinRT, có sẵn trong Windows PowerShell 5.1; title/msg truyền qua biến môi trường
# (-Command ghép mọi tham số thừa vào script -> không truyền nội dung qua argv để tránh injection). AppId của PowerShell để toast hiện mà không cần đăng ký app.
WIN_TOAST = r"""
$null = [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime]
$x = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02)
$t = $x.GetElementsByTagName('text')
$null = $t.Item(0).AppendChild($x.CreateTextNode($env:CCMON_TOAST_TITLE))
$null = $t.Item(1).AppendChild($x.CreateTextNode($env:CCMON_TOAST_MSG))
$id = '{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe'
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier($id).Show([Windows.UI.Notifications.ToastNotification]::new($x))
"""


def tool_brief(name, inp):
    inp = inp or {}
    for k in ("command", "file_path", "pattern", "url", "query", "description", "prompt"):
        if isinstance(inp.get(k), str):
            return "%s: %s" % (name, inp[k].replace("\n", " ")[:120])
    return name


def hook():
    data = read_stdin_json()
    sid = data.get("session_id")
    if not sid:
        return
    ev = data.get("hook_event_name", "")
    now = time.time()
    s = load(sid) or {"session_id": sid, "started": now, "status": "idle", "seen": True}
    s["cwd"] = data.get("cwd") or s.get("cwd") or os.getcwd()
    s["transcript"] = data.get("transcript_path") or s.get("transcript", "")
    if not s.get("pid") or ev == "SessionStart":
        s["pid"] = claude_pid()
        s.update(host_info())
        s["remote"] = remote_url_of_pid(s["pid"])
        if s["remote"]:
            s["app"] = "Remote"
    s["updated"] = now
    proj = title_of(s)

    if ev == "SessionStart":
        if s["status"] in ("closed", "lost"):
            s["status"] = "idle"
    elif ev == "UserPromptSubmit":
        p = (data.get("prompt") or "").strip()
        s.setdefault("first_prompt", p[:300])
        s["last_prompt"] = p[:500]
        s.update(status="running", seen=False, turn_started=now, message="", activity="")
    elif ev == "PreToolUse":
        s.update(status="running", activity=tool_brief(data.get("tool_name", ""), data.get("tool_input")))
    elif ev == "PostToolUse":
        s["status"] = "running"
    elif ev == "Notification":
        msg = data.get("message", "")
        ntype = data.get("notification_type", "")
        if ntype == "idle_prompt" or "waiting for your input" in msg:
            pass  # nhắc nhở sau khi đã Stop, giữ nguyên trạng thái "done"
        else:
            s.update(status="waiting", message=msg, seen=False)
            notify(T("⏸ Claude is waiting — ", "⏸ Claude chờ bạn — ") + proj, msg)
    elif ev == "Stop":
        s.update(status="done", seen=False, message="", activity="",
                 reply=last_reply(s["transcript"])[:1500], finished=now)
        dur = now - s.get("turn_started", now)
        notify(T("✅ Claude is done — ", "✅ Claude xong — ") + proj, "(%s) %s" % (fmt_dur(dur), (s.get("reply") or s.get("last_prompt", ""))[:180]))
    elif ev == "SessionEnd":
        s.update(status="closed", reason=data.get("reason", ""))
    save(s)


# ---------- statusLine / quota ----------

def fmt_reset(ts):
    if not ts:
        return ""
    d = ts - time.time()
    if d <= 0:
        return T("reset", "đã reset")
    if d < 86400:
        return "reset " + time.strftime("%H:%M", time.localtime(ts))
    return "reset " + time.strftime("%d/%m %H:%M", time.localtime(ts))


def usage():
    """Quota gần nhất; ô nào đã qua giờ reset thì coi như 0%."""
    u = read_json(USAGE, {})
    out = {"updated": u.get("updated"), "model": u.get("model")}
    for k in ("five_hour", "seven_day"):
        v = (u.get("rate_limits") or {}).get(k)
        if not v:
            continue
        v = dict(v)
        if v.get("resets_at") and v["resets_at"] < time.time():
            v.update(used_percentage=0, expired=True)
        out[k] = v
    return out


def statusline():
    data = read_stdin_json()
    sid = data.get("session_id", "")
    now = time.time()
    rl = data.get("rate_limits")
    if rl:
        write_json(USAGE, {"rate_limits": rl, "updated": now,
                           "model": (data.get("model") or {}).get("display_name")})
    if sid:
        ctx = data.get("context_window") or {}
        write_json(os.path.join(SL_DIR, sid + ".json"), {
            "session_name": data.get("session_name") or "",
            "model": (data.get("model") or {}).get("display_name"),
            "ctx_pct": ctx.get("used_percentage"),
            "cost": (data.get("cost") or {}).get("total_cost_usd"),
            "updated": now})
    # dòng hiển thị trong Claude Code
    parts = []
    name = read_json(NAMES, {}).get(sid)
    if name:
        parts.append("📌 " + name)
    u = usage()
    for k, lbl in (("five_hour", "5h"), ("seven_day", "7d")):
        v = u.get(k)
        if v:
            pct = v.get("used_percentage") or 0
            dot = "🔴" if pct >= 90 else "🟠" if pct >= 70 else "🟢"
            parts.append("%s %s %d%% (%s)" % (dot, lbl, pct, fmt_reset(v.get("resets_at"))))
    ctx = (data.get("context_window") or {}).get("used_percentage")
    if ctx is not None:
        parts.append("ctx %d%%" % ctx)
    sys.stdout.write("  ·  ".join(parts))


def render_usage():
    u = usage()
    if not u.get("updated"):
        return T("No quota data yet (needs at least one Claude Code session showing the statusLine).",
                 "Chưa có dữ liệu quota (cần ít nhất 1 phiên Claude Code hiển thị statusLine).")
    out = []
    for k, lbl in (("five_hour", T("5-hour", "Phiên 5 giờ")), ("seven_day", T("Week (7d)", "Tuần (7 ngày)"))):
        v = u.get(k)
        if v:
            pct = v.get("used_percentage") or 0
            bar = "█" * int(pct / 5) + "░" * (20 - int(pct / 5))
            out.append("%-14s %s %3d%%  %s" % (lbl, bar, pct, fmt_reset(v.get("resets_at"))))
    out.append(T("(updated %s ago)", "(cập nhật %s trước)") % fmt_dur(time.time() - u["updated"]))
    return "\n".join(out)


# ---------- hiển thị ----------

def ps_table():
    """{pid: tên tiến trình} của mọi tiến trình."""
    if IS_WIN:
        try:
            return {pid: exe for pid, (_, exe) in _win_procs().items()}
        except Exception:
            return {}
    if IS_LINUX:
        t = {}
        for d in os.listdir("/proc"):
            if d.isdigit():
                info = proc_parent(int(d))
                if info:
                    t[int(d)] = info[1]
        return t
    try:
        out = subprocess.check_output(["ps", "-axo", "pid=,comm="], text=True)
    except Exception:
        return {}
    t = {}
    for ln in out.splitlines():
        parts = ln.strip().split(None, 1)
        if len(parts) == 2 and parts[0].isdigit():
            t[int(parts[0])] = parts[1]
    return t


# ---------- khôi phục phiên bị tắt đột ngột (giống "Restore pages" của Chrome) ----------

RESTORE_MODES = ("ask", "auto", "off")
_BOOT = None


def restore_mode():
    m = os.environ.get("CCMON_RESTORE") or read_json(CONFIG, {}).get("restore") or "ask"
    return m if m in RESTORE_MODES else "ask"


def boot_time():
    """Thời điểm máy khởi động (epoch). Phiên cập nhật lần cuối trước mốc này chắc chắn đã chết,
    kể cả khi PID cũ đã bị một tiến trình claude khác dùng lại sau reboot."""
    global _BOOT
    if _BOOT is None:
        _BOOT = 0
        try:
            if IS_LINUX:
                with open("/proc/stat") as f:
                    _BOOT = next(int(ln.split()[1]) for ln in f if ln.startswith("btime "))
            elif IS_WIN:
                import ctypes
                ctypes.windll.kernel32.GetTickCount64.restype = ctypes.c_ulonglong
                _BOOT = time.time() - ctypes.windll.kernel32.GetTickCount64() / 1000.0
            else:  # "{ sec = 1731800000, usec = 123 } Sun Nov ..."
                out = subprocess.check_output(["sysctl", "-n", "kern.boottime"], text=True)
                _BOOT = int(re.search(r"sec = (\d+)", out).group(1))
        except Exception:
            _BOOT = 0
    return _BOOT


def restorable(s):
    """Có đáng mở lại không: đã có ít nhất một prompt, không phải phiên SDK/headless."""
    return (restore_mode() != "off" and bool(s.get("last_prompt") or s.get("first_prompt"))
            and s.get("app") != "headless" and bool(re.match(r"^[A-Za-z0-9_-]+$", s.get("session_id", ""))))


def _persist(sid, expect_updated, **fields):
    """Ghi trạng thái mà không giẫm lên hook: chỉ ghi nếu file chưa bị hook cập nhật kể từ lúc đọc."""
    cur = load(sid)
    if cur and cur.get("updated") == expect_updated:
        cur.update(fields)
        save(cur)
        return cur
    return None


def effective(s, procs):
    st = s.get("status", "idle")
    if st == "closed":
        return st
    if st == "lost":
        keep = restore_mode() != "off" and time.time() - s.get("lost_at", 0) < KEEP_LOST_SEC
        return "lost" if keep else "closed"
    pid = s.get("pid")
    comm = procs.get(pid, "") if pid else ""
    # chết mà không có SessionEnd (crash, kill, tắt terminal/máy đột ngột) -> có thể khôi phục
    dead = (pid and not is_claude_proc(comm, vscode=True)) or (boot_time() and s.get("updated", 0) < boot_time())
    if dead:
        recent = time.time() - s.get("updated", 0) < KEEP_LOST_SEC
        return "lost" if recent and restorable(s) else "closed"
    if st == "running" and time.time() - s.get("updated", 0) > 30 and was_interrupted(s.get("transcript", "")):
        return "interrupted"
    return st


def snapshot(include_closed=False):
    procs = ps_table()
    now = time.time()
    names = read_json(NAMES, {})
    cfg = read_json(CONFIG, {})
    # lần đầu chạy bản có tính năng khôi phục: phiên đã chết từ trước coi như đã đóng, không đề nghị mở lại
    first = "restore_since" not in cfg
    rows = []
    for s in all_sessions():
        st = effective(s, procs)
        if st == "lost" and s.get("status") != "lost":
            if first:
                st = "closed"
                _persist(s["session_id"], s.get("updated"), status="closed", reason="before-restore-feature")
            else:
                s = _persist(s["session_id"], s.get("updated"), status="lost", lost_at=now,
                             lost_from=s.get("status")) or s
        if st == "closed" and now - s.get("updated", 0) > KEEP_CLOSED_SEC:
            try:
                os.remove(_path(s["session_id"]))
            except OSError:
                pass
            continue
        if st == "closed" and not include_closed:
            continue
        if "remote" not in s and s.get("app") == "headless" and st not in ("closed", "lost"):
            s["remote"] = remote_url_of_pid(s.get("pid"))  # phiên ghi trước khi có nhận diện Remote
            if s["remote"]:
                s["app"] = "Remote"
        sl = read_json(os.path.join(SL_DIR, s["session_id"] + ".json"), {})
        s["state"] = st
        s["project"] = os.path.basename((s.get("cwd") or "").rstrip("/\\"))
        s["name"] = names.get(s["session_id"], "")
        s["auto_name"] = sl.get("session_name", "")
        s["title"] = title_of(s, names, sl)
        s["model"] = sl.get("model")
        s["ctx_pct"] = sl.get("ctx_pct")
        s["cost"] = sl.get("cost")
        rows.append(s)
    rows.sort(key=lambda r: (ORDER.index(r["state"]), r.get("seen", True), -r.get("updated", 0)))
    if first:
        cfg = read_json(CONFIG, {})
        cfg["restore_since"] = now
        write_json(CONFIG, cfg)
    return rows


def lost_sessions():
    return [r for r in snapshot(True) if r["state"] == "lost"]


def restore(target="all"):
    """Mở lại phiên bị tắt đột ngột bằng `claude --resume` trong tab terminal mới.
    Trả về [(session_id, kết quả)]. Bản ghi cũ đánh dấu closed/restored; khi claude resume,
    SessionStart cùng session_id sẽ đưa nó về trạng thái mở."""
    out = []
    for r in lost_sessions():
        sid = r["session_id"]
        if target != "all" and not sid.startswith(target):
            continue
        s = load(sid)
        if not s:
            continue
        res = term(s)
        if res == "ok":
            cur = load(sid)
            if cur and cur.get("status") == "lost":
                cur.update(status="closed", reason="restored", restored_at=time.time())
                save(cur)
        out.append((sid, res))
        if IS_MAC:
            time.sleep(0.3)  # iTerm tạo tab tuần tự, tránh dồn AppleScript
    return out


def dismiss(target="all"):
    for s in all_sessions():
        if s.get("status") == "lost" and (target == "all" or s["session_id"].startswith(target)):
            s.update(status="closed", reason="dismissed")
            save(s)


def restore_watcher(interval=5):
    """Chạy trong `ccmon serve`: phiên mới bị tắt đột ngột -> mode ask: báo một lần; auto: mở lại luôn."""
    while True:
        try:
            fresh = [r for r in lost_sessions() if not r.get("lost_notified")]
            for r in fresh:
                _persist(r["session_id"], r.get("updated"), lost_notified=True)
            if fresh and restore_mode() == "auto":
                for r in fresh:
                    restore(r["session_id"])
                notify(T("🔄 Restored %d Claude session(s)", "🔄 Đã mở lại %d phiên Claude") % len(fresh),
                       ", ".join(r["title"] for r in fresh)[:200])
            elif fresh:
                notify(T("⚠️ %d Claude session(s) closed unexpectedly", "⚠️ %d phiên Claude bị tắt đột ngột") % len(fresh),
                       T("Restore: open Claude Shepherd or run `ccmon restore all` — ",
                         "Khôi phục: mở Claude Shepherd hoặc chạy `ccmon restore all` — ")
                       + ", ".join(r["title"] for r in fresh)[:160])
        except Exception:
            pass
        time.sleep(interval)


SEARCH_FIELDS = ("title", "name", "auto_name", "project", "cwd", "app", "session_id",
                 "last_prompt", "reply", "message", "activity", "model")


def fold(s):
    """Chữ thường + bỏ dấu (tiếng Việt: "Đổi" -> "doi") để tìm không phân biệt dấu."""
    s = unicodedata.normalize("NFD", str(s or "").lower().replace("đ", "d"))
    return "".join(c for c in s if not unicodedata.combining(c))


def matches(r, query):
    """Mọi từ trong query phải xuất hiện ở ít nhất một trường (AND, không phân biệt hoa thường/dấu)."""
    hay = fold(" ".join(str(r.get(k) or "") for k in SEARCH_FIELDS))
    return all(w in hay for w in fold(query).split())


def fmt_dur(sec):
    sec = int(max(0, sec))
    if sec < 60:
        return "%ds" % sec
    if sec < 3600:
        return "%dm" % (sec // 60)
    if sec < 86400:
        return "%dh%02dm" % (sec // 3600, sec % 3600 // 60)
    return "%dd" % (sec // 86400)


COLOR = {"waiting": "\033[1;33m", "done": "\033[1;32m", "running": "\033[1;36m",
         "interrupted": "\033[1;35m", "idle": "\033[37m", "closed": "\033[90m"}


def render(include_closed=False, query=""):
    rows = [r for r in snapshot(include_closed) if matches(r, query)]
    now = time.time()
    if not rows and query:
        return T("No sessions match '%s'%s.\n", "Không có phiên nào khớp '%s'%s.\n") % (
            query, "" if include_closed else T(" (add -a to include closed sessions)", " (thêm -a để tìm cả phiên đã đóng)"))
    if not rows:
        return T("No open Claude sessions (the hook only sees sessions started after install).\n",
                 "Không có phiên Claude nào đang mở (hook chỉ ghi nhận phiên khởi động sau khi cài).\n")
    width = os.get_terminal_size().columns if sys.stdout.isatty() else 140
    out = ["%-8s  %-12s %-11s %-24s %6s  %s" % ("ID", T("STATE", "TRẠNG THÁI"), T("WHERE", "Ở ĐÂU"), T("SESSION", "PHIÊN"), T("AGE", "LÂU"), T("DETAIL", "NỘI DUNG"))]
    for r in rows:
        st = r["state"]
        new = st in ("done", "waiting") and not r.get("seen", True)
        lbl = ("● " if new else "  ") + label(st)
        if st == "running":
            detail = r.get("activity") or r.get("last_prompt", "")
        elif st == "waiting":
            detail = r.get("message", "")
        elif st == "done":
            detail = "↳ " + (r.get("reply") or "").split("\n")[0]
        else:
            detail = r.get("last_prompt") or ""
        detail = "%s  « %s" % (detail, (r.get("last_prompt") or "")[:60]) if st in ("done", "waiting") else detail
        line = "%-8s  %-12s %-11s %-24s %6s  %s" % (
            r["session_id"][:8], lbl, r.get("app", "?")[:11], r["title"][:24],
            fmt_dur(now - r.get("updated", now)), detail.replace("\n", " "))
        out.append(COLOR.get(st, "") + line[:width] + "\033[0m")
    counts = {}
    for r in rows:
        counts[r["state"]] = counts.get(r["state"], 0) + 1
    out.append("\n" + "  ".join("%s: %d" % (label(k), counts[k]) for k in ORDER if k in counts))
    out.append(render_usage())
    return "\n".join(out) + "\n"


