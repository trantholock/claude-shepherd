        print("login item %s: HKCU\\%s\\%s" % (action, WIN_RUN_KEY, WIN_RUN_NAME))
        return
    if action == "install":
        os.makedirs(os.path.dirname(SYSTEMD_UNIT), exist_ok=True)
        with open(SYSTEMD_UNIT, "w", encoding="utf-8") as f:
            f.write(SYSTEMD_TMPL % {"py": _py(), "ccmon": _self(), "version": VERSION})
        if _systemctl("daemon-reload") and _systemctl("enable", "--now", "claude-shepherd.service") \
