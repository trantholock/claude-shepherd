def setup(action, with_service=True):
    if IS_MAC:
        raise SystemExit(T("On macOS use `make install` / `make uninstall` (also builds the app).",
                           "Trên macOS dùng `make install` / `make uninstall` (kèm build app)."))
    os.makedirs(BASE, exist_ok=True)
    settings_hooks(action, hook_command())
    if with_service:
        service(action)
    if action == "install":
        print(T("Done. Dashboard: http://127.0.0.1:7788 — sessions started from now on are tracked.",
                "Xong. Dashboard: http://127.0.0.1:7788 — các phiên mở từ giờ sẽ được theo dõi."))
    else:
        print(T("Removed. Session data is kept in %s (delete it by hand if you want).",
                "Đã gỡ. Dữ liệu phiên vẫn ở %s (xoá tay nếu muốn).") % BASE)


# ---------- web ----------

def serve(port):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlparse

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="application/json"):
            b = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype + "; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(b)

        def do_GET(self):
            u = urlparse(self.path)
            if u.path == "/api/sessions":
                all_ = parse_qs(u.query).get("all", ["0"])[0] == "1"
                self._send(200, json.dumps({"now": time.time(), "rows": snapshot(all_), "usage": usage()},
                                           ensure_ascii=False))
            elif u.path == "/":
                self._send(200, PAGE.replace("__LANG__", "vi" if is_vi() else "en"), "text/html")
            else:
                self._send(404, "{}")

        def do_POST(self):
            # chỉ nhận request từ chính trang dashboard
            if self.headers.get("X-CCMon") != "1":
                return self._send(403, "{}")
            u = urlparse(self.path)
            q = parse_qs(u.query)
            sid = q.get("id", [""])[0]
            res = "ok"
            if u.path == "/api/ack":
                ack(sid or "all")
            elif u.path == "/api/rename":
                set_name(sid, q.get("name", [""])[0])
            elif u.path == "/api/forget":
                forget(sid)
            elif u.path == "/api/focus":
                s = load(sid)
                res = focus(s) if s else "notfound"
            elif u.path == "/api/restore":
                res = restore(sid or "all")
            elif u.path == "/api/dismiss":
                dismiss(sid or "all")
            elif u.path == "/api/term":
                s = load(sid)
                res = term(s) if s else "notfound"
            self._send(200, json.dumps({"result": res}))

    srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    if os.environ.get("CCMON_WATCH", "1") != "0":
        import threading
        threading.Thread(target=restore_watcher, daemon=True).start()
    os.makedirs(BASE, exist_ok=True)
    if sys.stderr is None:  # pythonw (Windows) không có stderr
        sys.stderr = open(os.path.join(BASE, "serve.log"), "a", encoding="utf-8")
    write_json(PIDFILE, os.getpid())
    if sys.stdout:
        print("ccmon dashboard: http://127.0.0.1:%d" % port, flush=True)
    srv.serve_forever()


