            if rows:
                print(T("\nccmon restore all | ccmon restore <id> | ccmon restore dismiss [id]",
                        "\nccmon restore all | ccmon restore <id> | ccmon restore dismiss [id]"))
    elif cmd == "clean":
        procs = ps_table()
