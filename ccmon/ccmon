def vscode_storage():
    if IS_MAC:
        root = os.path.expanduser("~/Library/Application Support")
    elif IS_WIN:
        root = os.environ.get("APPDATA") or os.path.expanduser("~/AppData/Roaming")
    else:
        root = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(root, "Code", "User", "globalStorage", "storage.json")


def _norm(p):
    # so sánh đường dẫn: Windows không phân biệt hoa thường và dùng cả \ lẫn /
    return os.path.normcase(p.replace("\\", "/").rstrip("/")) if IS_WIN else p.rstrip("/")


def vscode_folder(cwd):
    """Thư mục đang mở trong VSCode chứa cwd (sâu nhất), để focus đúng cửa sổ thay vì mở cửa sổ mới."""
    st = read_json(vscode_storage(), {})
    ws = st.get("windowsState") or {}
    wins = list(ws.get("openedWindows") or []) + [ws.get("lastActiveWindow") or {}]
    best = ""
    c = _norm(cwd)
    for w in wins:
        f = w.get("folder") or ""
        if not f.startswith("file://"):
            continue
        f = unquote(f[7:]).rstrip("/")
        if IS_WIN and re.match(r"^/[A-Za-z]:", f):  # file:///c%3A/Users/... -> c:/Users/...
            f = f[1:]
        nf = _norm(f)
        sep = "\\" if IS_WIN else "/"
        if (c == nf or c.startswith(nf + sep)) and len(f) > len(best):
            best = f
    return best or cwd


def vscode_cli():
    if IS_MAC and os.path.exists("/usr/local/bin/code"):
        return "/usr/local/bin/code"
    return shutil.which("code") or "code"  # Windows: code.cmd


def focus(s):
    s["seen"] = True
    save(s)
    if s.get("remote") or (s.get("app") == "headless" and remote_url_of_pid(s.get("pid"))):
        return term(s)  # phiên mở từ mobile: không có tab nào để focus -> resume trong iTerm
    if s.get("app", "").startswith("VSCode") and s.get("cwd"):
        try:
            subprocess.run([vscode_cli(), vscode_folder(s["cwd"])], creationflags=NO_WINDOW)
        except OSError as e:
            return str(e)
        return "ok"
    if s.get("iterm") and IS_MAC:
        script = '''
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with ss in sessions of t
        if unique id of ss is "%s" then
          select w
          select t
          select ss
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell
return "notfound"''' % s["iterm"]
        r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
        return r.stdout.strip() or r.stderr.strip()
    if not IS_MAC and s.get("state", s.get("status")) == "closed":
        return term(s)
    return T("don't know how to focus app %s (use `ccmon term`)",
             "không biết cách focus app %s (dùng `ccmon term`)") % s.get("app")


ITERM_NEW_TAB = '''
on run argv
  set cmd to item 1 of argv
  tell application "iTerm2"
    activate
    if (count of windows) = 0 then
      create window with default profile command cmd
    else
      tell current window to create tab with default profile command cmd
    end if
  end tell
  return "ok"
end run'''


def term(s):
    """Mở phiên trong tab iTerm mới bằng `claude --resume <id>`.
    - Phiên Remote Control đang rảnh (xong/idle): dừng tiến trình chạy ngầm của remote-control
      rồi resume đúng phiên -> chuyển hẳn phiên sang terminal, không có 2 tiến trình cùng ghi.
    - Phiên còn đang làm việc (running/waiting) hoặc đang mở ở tab khác: --fork-session
      (bản sao đủ lịch sử) để không làm gián đoạn nó."""
    s["seen"] = True
    save(s)
    st = effective(s, ps_table())
    remote = s.get("remote") or (remote_url_of_pid(s.get("pid")) if s.get("app") == "headless" else "")
    fork = False
    if st not in ("closed", "lost"):
        if remote and st not in ("running", "waiting") and remote_url_of_pid(s.get("pid")):
            pid = s["pid"]
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
            for _ in range(30):
                if not pid_alive(pid):
                    break
                time.sleep(0.1)
            else:
                fork = True  # không dừng được -> fork cho an toàn
        else:
            fork = True
    sid = s["session_id"]
    if not re.match(r"^[A-Za-z0-9_-]+$", sid):  # sid đi vào lệnh shell
        return "invalid session id"
    cwd = s.get("cwd") or os.path.expanduser("~")
    if not os.path.isdir(cwd):
        cwd = os.path.expanduser("~")
    args = ["claude", "--resume", sid] + (["--fork-session"] if fork else [])
    try:
        return open_terminal(cwd, args)
    except Exception as e:
        return str(e)


def open_terminal(cwd, args):
    """Chạy `args` trong cwd ở một tab/cửa sổ terminal mới; khi lệnh kết thúc thì giữ shell mở."""
    if IS_MAC:
        cmd = "cd %s && %s" % (shlex.quote(cwd), " ".join(shlex.quote(a) for a in args))
        # chạy lệnh trực tiếp khi tạo tab (không "write text" vì gõ phím lúc zsh chưa sẵn sàng bị lẫn ký tự),
        # xong thì thả về zsh để tab không tự đóng
        shell = "/bin/zsh -lic %s" % shlex.quote(cmd + "; exec /bin/zsh -l")
        r = subprocess.run(["osascript", "-e", ITERM_NEW_TAB, shell], capture_output=True, text=True)
        return r.stdout.strip() or r.stderr.strip()
    if IS_WIN:
        claude = shutil.which("claude") or "claude"
        wt = shutil.which("wt")
        if wt:  # Windows Terminal: tab mới; cmd /k giữ cửa sổ sau khi claude thoát
            subprocess.Popen([wt, "-w", "0", "new-tab", "-d", cwd, "cmd", "/k", claude] + args[1:])
        else:
            subprocess.Popen(["cmd", "/k", claude] + args[1:], cwd=cwd,
                             creationflags=subprocess.CREATE_NEW_CONSOLE)
        return "ok"
    # Linux: $CCMON_TERMINAL (vd "kitty -e") > terminal phổ biến đầu tiên tìm thấy
    sh = os.environ.get("SHELL") or "/bin/bash"
    inner = [sh, "-lic", "%s; exec %s -l" % (" ".join(shlex.quote(a) for a in args), shlex.quote(sh))]
    custom = os.environ.get("CCMON_TERMINAL")
    if custom:
        launch = shlex.split(custom) + inner
    else:
        for name, pre in LINUX_TERMINALS:
            if shutil.which(name):
                launch = [name] + pre + inner
                break
        else:
            return T("no terminal emulator found; set CCMON_TERMINAL (e.g. \"kitty -e\")",
                     "không tìm thấy terminal; đặt CCMON_TERMINAL (vd \"kitty -e\")")
    subprocess.Popen(launch, cwd=cwd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return "ok"


