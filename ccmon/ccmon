.qb{display:flex;flex-direction:column;gap:2px;min-width:150px}
.qt{display:flex;justify-content:space-between;gap:8px}.qt b{font-variant-numeric:tabular-nums}
.bar{height:6px;border-radius:3px;background:var(--line);overflow:hidden}.bar i{display:block;height:100%;border-radius:3px}
.ren{border:none;background:none;padding:0 4px;color:var(--mut);cursor:pointer;font-size:13px}.ren:hover{color:var(--fg)}
.sub{font-weight:400}
</style></head><body>
<header><h1>Claude Shepherd</h1><span id="sum"></span><span class="sp"></span><span class="q" id="quota"></span>
<label><input type="checkbox" id="all"> hiện phiên đã đóng</label>
<button onclick="act('ack','all')">Đánh dấu đã xem hết</button></header>
<main id="m"><div class="empty">Đang tải…</div></main>
<script>
const L={waiting:"CHỜ BẠN",done:"XONG",running:"ĐANG CHẠY",interrupted:"BỊ NGẮT",idle:"MỞ, CHƯA LÀM",closed:"ĐÃ ĐÓNG"};
const C={waiting:"wait",done:"done",running:"run",interrupted:"int",idle:"idle",closed:"idle"};
const G=[["Cần bạn xử lý",r=>(r.state=="waiting"||r.state=="done"||r.state=="interrupted")&&!r.seen],
 ["Đang chạy",r=>r.state=="running"],["Chờ bạn",r=>r.state=="waiting"&&r.seen],
 ["Xong / đã xem",r=>(r.state=="done"||r.state=="interrupted")&&r.seen],["Mở, chưa làm gì",r=>r.state=="idle"],["Đã đóng",r=>r.state=="closed"]];
const esc=s=>(s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
function ago(t,now){let s=Math.max(0,now-t|0);if(s<60)return s+"s";if(s<3600)return (s/60|0)+"m";if(s<86400)return (s/3600|0)+"h"+String((s%3600/60|0)).padStart(2,"0");return (s/86400|0)+"d"}
async function act(a,id,extra=""){await fetch(`/api/${a}?id=${encodeURIComponent(id)}${extra}`,{method:"POST",headers:{"X-CCMon":"1"}});load()}
const ROWS={};
function ren(id){const r=ROWS[id];const n=prompt("Tên phiên (để trống = dùng tên tự động):",r.name||r.title||"");if(n!==null)act("rename",id,"&name="+encodeURIComponent(n))}
function qcolor(p){return p>=90?"#e53e3e":p>=70?"var(--wait)":"var(--done)"}
function rst(t,now){if(!t)return"";const d=t-now;if(d<=0)return"đã reset";const dt=new Date(t*1000);
 return "reset "+(d<86400?dt.toLocaleTimeString("vi-VN",{hour:"2-digit",minute:"2-digit"}):dt.toLocaleString("vi-VN",{weekday:"short",hour:"2-digit",minute:"2-digit"}))}
function quota(u,now){if(!u||!u.updated)return'<span class="mut">chưa có dữ liệu quota</span>';
 return [["five_hour","5 giờ"],["seven_day","7 ngày"]].filter(([k])=>u[k]).map(([k,l])=>{const v=u[k],p=Math.round(v.used_percentage||0);
 return `<div class="qb" title="cập nhật ${ago(u.updated,now)} trước"><div class="qt"><span>${l} <b style="color:${qcolor(p)}">${p}%</b></span><span class="mut">${rst(v.resets_at,now)}</span></div><div class="bar"><i style="width:${p}%;background:${qcolor(p)}"></i></div></div>`}).join("")}
function card(r,now){ROWS[r.session_id]=r;const c=C[r.state],nw=!r.seen&&r.state!="running"&&r.state!="idle";
 let main="";if(r.state=="running")main=r.activity||"";else if(r.state=="waiting")main=r.message||"";else if(r.state=="done")main=r.reply||"";
 const dur=r.state=="running"&&r.turn_started?` · chạy ${ago(r.turn_started,now)}`:"";
 return `<div class="card ${nw?"new":""}" style="--c:var(--${c});--cb:var(--${c}-bg)">
 <div class="row"><span class="st">${nw?"● ":""}${L[r.state]}</span><span class="proj">${r.name?"📌 ":""}${esc(r.title)}<button class="ren" title="Đổi tên" onclick="ren('${r.session_id}')">✎</button></span>
 <span class="mut">${r.title!=r.project?esc(r.project)+" · ":""}${esc(r.app)} · ${r.session_id.slice(0,8)} · ${ago(r.updated,now)} trước${dur}${r.ctx_pct!=null?" · ctx "+r.ctx_pct+"%":""}</span>
 <span class="acts"><button onclick="act('focus','${r.session_id}')">Mở</button>
 ${nw?`<button onclick="act('ack','${r.session_id}')">Đã xem</button>`:""}
 ${r.state=="closed"?`<button onclick="act('forget','${r.session_id}')">Xóa</button>`:""}</span></div>
 ${r.last_prompt?`<div class="body q">» ${esc(r.last_prompt)}</div>`:""}
 ${main?`<div class="body">${esc(main)}</div>`:""}</div>`}
async function load(){try{const all=document.getElementById("all").checked;
 const d=await (await fetch("/api/sessions?all="+(all?1:0))).json();const rows=d.rows,now=d.now;
 const need=rows.filter(G[0][1]).length,run=rows.filter(r=>r.state=="running").length;
 document.title=(need?`(${need}) `:"")+"Claude Shepherd";
 document.getElementById("quota").innerHTML=quota(d.usage,now);
 document.getElementById("sum").innerHTML=`<span class="pill" style="background:var(--wait-bg);color:var(--wait)">${need} cần bạn</span> <span class="pill" style="background:var(--run-bg);color:var(--run)">${run} đang chạy</span> <span class="mut">${rows.length} phiên</span>`;
 const used=new Set();let h="";for(const [t,f] of G){const g=rows.filter(r=>!used.has(r.session_id)&&f(r));g.forEach(r=>used.add(r.session_id));
 if(g.length)h+=`<h2>${t} (${g.length})</h2>`+g.map(r=>card(r,now)).join("")}
 document.getElementById("m").innerHTML=h||'<div class="empty">Không có phiên nào. Mở một phiên Claude Code mới để bắt đầu theo dõi.</div>'}catch(e){}}
document.getElementById("all").onchange=load;load();setInterval(load,2000);
</script></body></html>"""


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "ls"
    if cmd == "hook":
        try:
            hook()
        except Exception as e:  # không bao giờ làm hỏng phiên Claude
            try:
                os.makedirs(STATE, exist_ok=True)
                with open(os.path.join(STATE, "..", "hook-errors.log"), "a") as f:
                    f.write("%s %r\n" % (time.strftime("%F %T"), e))
            except Exception:
                pass
        return
    if cmd in ("ls", "-a"):
        sys.stdout.write(render("-a" in a))
    elif cmd == "watch":
        try:
            while True:
                sys.stdout.write("\033[H\033[2J" + time.strftime("%H:%M:%S") + "  (Ctrl-C để thoát)\n\n" + render("-a" in a))
                sys.stdout.flush()
                time.sleep(2)
        except KeyboardInterrupt:
            pass
    elif cmd == "statusline":
        try:
            statusline()
        except Exception as e:
            sys.stdout.write("ccmon statusline lỗi: %s" % e)
    elif cmd == "usage":
        print(render_usage())
    elif cmd == "name" and len(a) > 1:
        s = find(a[1])
        if not s:
            print("không tìm thấy phiên duy nhất khớp '%s'" % a[1])
        else:
            set_name(s["session_id"], " ".join(a[2:]))
            print("%s -> %s" % (s["session_id"][:8], title_of(s)))
    elif cmd == "serve":
        serve(int(a[1]) if len(a) > 1 else 7788)
    elif cmd == "focus" and len(a) > 1:
        s = find(a[1])
        print(focus(s) if s else "không tìm thấy phiên duy nhất khớp '%s'" % a[1])
    elif cmd == "ack":
        ack(a[1] if len(a) > 1 else "all")
    elif cmd == "clean":
        procs = ps_table()
        for s in all_sessions():
            if effective(s, procs) == "closed":
                forget(s["session_id"])
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
